# ============================================================
# Supply Chain Disruption Monitoring System - Environment
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=supply_chain
POSTGRES_USER=scm_user
POSTGRES_PASSWORD=scm_password
# Host port the container's PostgreSQL is published on. Override when 5432 is
# already taken on the host (containers still use postgres:5432 internally).
POSTGRES_HOST_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql://scm_user:scm_password@postgres:5432/supply_chain
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Optional authorization. Leave empty to disable the API key check.
# When set, state-changing endpoints require an X-API-Key header with this value.
API_KEY=

# --- Hindsight ---
HINDSIGHT_BASE_URL=http://hindsight:8888
HINDSIGHT_BANK_ID=supply-chain-memory

# The Hindsight image REQUIRES an LLM API key for any provider other than
# "none". Default "none" = keyless mode: chunk-based memory + local embeddings,
# fully functional without a key. With a real key, set:
#   HINDSIGHT_LLM_PROVIDER=google
HINDSIGHT_LLM_PROVIDER=none
HINDSIGHT_LLM_MODEL=gemini-1.5-flash

# --- LangGraph / LLM ---
# Provide your Google Gemini API key (used by LangGraph agents)
GOOGLE_API_KEY=your_google_api_key_here

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
# Must match API_KEY when authorization is enabled on the backend.
VITE_API_KEY=

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
